# --- Supabase (Project Settings > API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé service_role : SERVEUR UNIQUEMENT (sync catalogue, écriture commandes).
# Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Repli serveur uniquement. Les liens de confirmation d'e-mail sont
# construits à partir de l'hôte réel du navigateur (window.location.origin),
# pas de cette variable : figée à la compilation, elle enverrait tous les
# e-mails vers localhost si le build de production l'oubliait.
#
# Le lien final doit AUSSI figurer dans Supabase > Authentication >
# URL Configuration > Redirect URLs, sinon Supabase retombe sur la
# « Site URL » du projet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fournisseur SMM (SMMGen, API v2) ----------------------------------
# Clé de https://my.smmgen.com/account — SERVEUR UNIQUEMENT.
SMMGEN_API_KEY=
SMMGEN_API_URL=https://my.smmgen.com/api/v2

# Marge appliquée au prix fournisseur, en %
SMM_MARKUP_PERCENT=20

# Secret protégeant POST /api/smm/sync
SMM_SYNC_SECRET=change-me

# false = les commandes sont enregistrées mais PAS envoyées au fournisseur.
# Passez à true seulement quand le paiement est branché : chaque envoi
# dépense le solde réel du panel.
SMM_AUTO_SUBMIT=false

# --- WhatsApp -----------------------------------------------------------
# Numéro professionnel qui reçoit les demandes de finalisation (chiffres
# uniquement, format international sans +). Sans lui, le bouton est désactivé.
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=212600000000
# Indicatif appliqué aux numéros saisis au format national (0612… -> 212612…)
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=212
